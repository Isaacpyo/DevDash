# DevDash configuration. Every variable is optional for local development.
#   Local dev:       cp .env.example apps/web/.env.local
#   Docker Compose:  cp .env.example .env
# Never commit real values.

# --- GitHub data ------------------------------------------------------------
# Server-side token for the GitHub REST + GraphQL APIs. A classic personal access
# token with no scopes ticked (public data only) is enough.
# Without it, DevDash runs in sample-data mode.
GITHUB_TOKEN=

# "github" or "mock". Defaults to github when GITHUB_TOKEN is set, otherwise mock.
DATA_PROVIDER=

# Mock mode only: artificial delay (ms) to preview loading states. 0-10000.
MOCK_LATENCY_MS=0

# --- Sign in with GitHub (optional) -------------------------------------------
# OAuth App credentials (github.com/settings/developers). The callback URL must be
# <SITE_URL>/api/auth/github/callback. When unset, the GitHub button is hidden.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Set to "mock" to run the OAuth flow against a local fake (dev/e2e only).
OAUTH_PROVIDER=

# Encrypts the session cookie. Required in production for sign-in and the demo
# login; 32+ characters. Generate one with: openssl rand -base64 48
SESSION_SECRET=

# --- Cache ------------------------------------------------------------------
# Redis for the shared report cache (Upstash: use the rediss:// URL). Without it,
# each server instance uses an in-memory cache.
REDIS_URL=

# Seconds a report is served without revalidating (default 600).
CACHE_TTL_SECONDS=600
# Seconds a stale report may still be served while refreshing or rate limited (default 86400).
CACHE_STALE_SECONDS=86400

# --- Site -------------------------------------------------------------------
# Public base URL, used for OAuth callbacks and Open Graph images.
# Falls back to Netlify's URL variable, then http://localhost:3000.
SITE_URL=
